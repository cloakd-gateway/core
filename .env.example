# Cloakd Gateway Configuration
CLOAKD_HOST=0.0.0.0
CLOAKD_PORT=8080
CLOAKD_LOG_LEVEL=info

# Default Model (The provider is inferred automatically from the model name)
CLOAKD_DEFAULT_MODEL=gemini-3.8-flash

# Provider API Keys (Managed directly by Cloakd - no need for clients to send them)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom self-hosted / vLLM / Ollama upstream provider
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=

# Granular DLP Rules & Regional Packs
# Options: "default" (universal: email,card,iban,phone,secrets,ip), "all", or comma-separated packs/rules
# Available packs: default, all, banking, secrets, pii, eu, fr, us, uk, es
CLOAKD_ENABLED_RULES=default

# FinOps Cache & Resilience (V2)
CLOAKD_CACHE_ENABLED=true
CLOAKD_CACHE_TTL_SECS=3600
CLOAKD_CACHE_MAX_CAPACITY=10000
CLOAKD_FAILOVER_ENABLED=true
CLOAKD_FALLBACK_PROVIDERS=gemini,openai,anthropic


